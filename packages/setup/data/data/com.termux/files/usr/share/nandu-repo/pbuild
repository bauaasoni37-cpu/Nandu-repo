#!/data/data/com.termux/files/usr/bin/env bash
# ==============================================================================
# Script: pbuild
# Purpose: Universal Error-Free APK Builder for Native Android, Flutter & Expo React-Native
# ==============================================================================

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# Switch to proot Ubuntu if running from Termux
if ! [ -f /etc/os-release ] || ! grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
    RAW_PATH="${1:-$(pwd)}"
    if [ -d "$RAW_PATH" ]; then
        TARGET_DIR="$(cd "$RAW_PATH" && pwd)"
    else
        TARGET_DIR="$RAW_PATH"
    fi
    exec proot-distro login ubuntu -- bash -c "source /etc/profile.d/dev_env.sh 2>/dev/null || true && pbuild \"$TARGET_DIR\" \"${2:-}\""
fi

# Load full environment inside Ubuntu
if [ -f /etc/profile.d/dev_env.sh ]; then
    source /etc/profile.d/dev_env.sh 2>/dev/null || true
fi

export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
export ANDROID_HOME=/opt/android-sdk
export ANDROID_SDK_ROOT=/opt/android-sdk
export QEMU_LD_PREFIX=/usr/x86_64-linux-gnu
export PATH=$JAVA_HOME/bin:$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/build-tools/34.0.0:/opt/flutter/bin

PROJECT_DIR="${1:-$(pwd)}"
if [ -d "$PROJECT_DIR" ]; then
    PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
fi
cd "$PROJECT_DIR"

BUILD_TYPE="${2:-}"
if [ -z "$BUILD_TYPE" ]; then
    echo -e "${BLUE}Select Build Variant:${RESET}"
    echo "1) Debug (default - recommended for fast testing)"
    echo "2) Release"
    read -p "Choice [1/2]: " CHOICE
    case "$CHOICE" in
        2|release|Release) BUILD_TYPE="release" ;;
        *) BUILD_TYPE="debug" ;;
    esac
fi

echo -e "${CYAN}======================================================${RESET}"
echo -e "${CYAN}🔨 Building Project: $PROJECT_DIR ($BUILD_TYPE)${RESET}"
echo -e "${CYAN}======================================================${RESET}"

# Ensure gradlew scripts are executable
if [ -f "gradlew" ]; then chmod +x gradlew 2>/dev/null || true; fi
if [ -f "android/gradlew" ]; then chmod +x android/gradlew 2>/dev/null || true; fi

# Ensure AAPT2 Gradle override is present in project
mkdir -p ~/.gradle 2>/dev/null || true
if ! grep -q "android.aapt2FromMavenOverride" ~/.gradle/gradle.properties 2>/dev/null; then
    echo "android.aapt2FromMavenOverride=/usr/bin/aapt2" >> ~/.gradle/gradle.properties
fi

# Build Execution Router
if [ -f "pubspec.yaml" ]; then
    echo -e "${YELLOW}Detected Framework: Flutter${RESET}"
    flutter pub get
    if [ "$BUILD_TYPE" == "release" ]; then
        flutter build apk --release --no-tree-shake-icons
    else
        flutter build apk --debug --no-tree-shake-icons
    fi

elif [ -f "package.json" ] && (grep -q '"expo"' package.json 2>/dev/null || [ -f "app.json" ]); then
    echo -e "${YELLOW}Detected Framework: Expo / React-Native${RESET}"
    if [ ! -d "android" ]; then
        echo -e "${CYAN}Generating android native folder with expo prebuild...${RESET}"
        npx expo prebuild --platform android --no-install
    fi
    cd android
    chmod +x gradlew 2>/dev/null || true
    if [ -f "gradle.properties" ]; then
        sed -i 's/hermesEnabled=true/hermesEnabled=false/' gradle.properties 2>/dev/null || true
    fi
    if [ "$BUILD_TYPE" == "release" ]; then
        ./gradlew assembleRelease
    else
        ./gradlew assembleDebug
    fi
    cd ..

elif [ -f "gradlew" ] || [ -f "build.gradle" ] || [ -f "build.gradle.kts" ] || [ -f "android/gradlew" ]; then
    echo -e "${YELLOW}Detected Framework: Native Android (Gradle)${RESET}"
    if [ -f "android/gradlew" ]; then cd android; fi
    chmod +x gradlew 2>/dev/null || true
    if [ "$BUILD_TYPE" == "release" ]; then
        ./gradlew assembleRelease
    else
        ./gradlew assembleDebug
    fi
    if [ -f "../pubspec.yaml" ] || [ -f "../package.json" ]; then cd ..; fi
else
    echo -e "${RED}Error: Project framework not recognized (No pubspec.yaml, package.json, or build.gradle found).${RESET}"
    exit 1
fi

# Locate output APK
APK=$(find "$PROJECT_DIR" -type f -name "*.apk" 2>/dev/null | grep -i "$BUILD_TYPE" | head -n 1)
if [ -z "$APK" ]; then
    APK=$(find "$PROJECT_DIR" -type f -name "*.apk" 2>/dev/null | head -n 1)
fi

if [ -n "$APK" ]; then
    REAL_APK=$(readlink -f "$APK")
    SIZE=$(du -h "$REAL_APK" | cut -f1)
    echo -e "${GREEN}======================================================${RESET}"
    echo -e "${GREEN}✓ APK Built Successfully!${RESET}"
    echo -e "${GREEN}Location: ${REAL_APK} (${SIZE})${RESET}"
    echo -e "${GREEN}======================================================${RESET}"
else
    echo -e "${GREEN}✓ Build process completed successfully.${RESET}"
fi
